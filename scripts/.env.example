# Copy to .env, fill in, chmod 600. Gitignored.
#
# Deliberately separate from gateway/.env: a host can run the gateway without
# ever holding a credential that creates billable instances.

# ---------------------------------------------------------------- provider
#
# Which hardware the lifecycle scripts talk to. Everything above this line --
# gateway, tailnet policy, keys, spend, backups, draining -- is identical
# whichever you choose. See scripts/providers/README.md.
#
#   runpod   rented on-demand pods. Billed hourly, DESTROYED when idle.
#   ssh      a GPU box you own, or any VPS with a GPU + Docker + SSH.
#            Persistent: idle shutdown STOPS the engine, never the machine.
#   manual   you start the engine yourself; the scripts only observe.
#
# Adding a provider is one file in scripts/providers/ implementing six
# functions. Nothing else in the repo names a provider.
GPU_PROVIDER=runpod

# --- GPU_PROVIDER=ssh only -------------------------------------------------
# A tailnet name is ideal: then the box needs no public SSH at all.
#GPU_SSH_HOST=gpu-box
#GPU_SSH_USER=ubuntu
#GPU_SSH_KEY=~/.ssh/id_ed25519
#GPU_SSH_DIR=/opt/ai-infra

# --- every provider --------------------------------------------------------

# Ephemeral, tagged, pre-approved auth key minted in the Tailscale admin
# console for tag:gpu. Ephemeral so the node removes itself from the tailnet
# when it goes offline — right for instances destroyed nightly. Reusable, since
# gpu-up runs more than once. Max lifetime 90 days; rotate on that cadence.
# Revoking a key does NOT deauthorize already-connected nodes.
TS_AUTHKEY=tskey-auth-CHANGE-ME

# --- GPU_PROVIDER=runpod only ----------------------------------------------

# RunPod API key with pod create/terminate rights.
RUNPOD_API_KEY=CHANGE-ME

# Network volume. LEAVE EMPTY unless you have measured that you need one.
#
# It is not the obvious win it looks like. Measured on a live pod: 35 GB of
# weights fetched in 34 s, versus ~1 s from a warm volume. So it buys about half
# a minute of cold start, and costs:
#   - ~$0.07/GB/month, 24/7, whether or not a pod exists
#   - a hard pin to ONE datacenter, forever
#   - and only ~17 datacenters support volumes at all, which in practice can
#     exclude every region where the GPU you want currently has stock
#
# That last one is the killer: a volume can leave you unable to rent any
# suitable GPU. Empty means weights go on container disk, which is billed only
# while the pod runs and places no constraint on region.
#
# Sizing, if you do use one: 37.5 GB for the primary FP8 checkpoint, 30.9 GB more
# if you also keep the 27B A/B candidate (Qwen3.6-27B-FP8 — an official FP8
# checkpoint does exist; an earlier note here assumed BF16 at ~54 GB). ~80 GB is
# honest for both; 200 GB was guessed.
RUNPOD_VOLUME_ID=

# Container disk when running WITHOUT a network volume. Must fit the image plus
# the checkpoint plus room to unpack it. Billed only while the pod exists.
RUNPOD_DISK_GB=120

# Ordered preference — dataCenterPriority=custom.
#
# Pick these on availability and jurisdiction, not latency: RTT lands only in
# time-to-first-token and token streaming hides it thereafter. The useful
# question is whether the GPU's region shares a failure mode (power grid,
# network, legal jurisdiction) with the office that depends on it. Somewhere
# decorrelated from your users beats somewhere close to them.
# A network volume is pinned to ONE datacenter, so a real fallback region needs
# its own volume; until then the second entry only helps if you accept a
# re-download.
RUNPOD_DATACENTERS=EU-SE-1,EU-NL-1,EU-RO-1

# Ada or newer, and 48 GB on ONE card. FP8 needs Ada: L40S and RTX 6000 Ada have
# native FP8 tensor cores; A6000/A40 are Ampere and do not, so serving the FP8
# checkpoint on them is a silent performance loss rather than an error.
#
# 48 GB on one card, not 48 GB in total: the checkpoint is ~35 GB, so a 24 GB
# card (RTX 4090) needs tensor parallelism, and consumer cards have no NVLink —
# TP then crosses PCIe and costs more than the cheaper hourly rate saves.
#
# Known-good ids (./scripts/gpu-up.sh --check-capacity prices whichever you set):
#   NVIDIA RTX 6000 Ada Generation   48 GB, usually the cheapest that qualifies
#   NVIDIA L40S                      48 GB, inference-tuned
# Quotes are required: common.sh sources this file with the shell, so an
# unquoted value containing a space parses as `VAR=NVIDIA` followed by the
# command `L40S` and every lifecycle script dies with "command not found".
RUNPOD_GPU_TYPE="NVIDIA L40S"

# --- every provider --------------------------------------------------------

# 1 steady-state. Set 2 only for the measurement week, or on a 2-card box.
# Raising this to 2 also means uncommenting `ipc: host` in
# gpu/docker-compose.yml the same day — without it multi-GPU startup fails with
# a cryptic NCCL error rather than a clear one. verify.sh asserts they move
# together.
GPU_COUNT=1
TP=1
MAX_MODEL_LEN=65536

# Hardware constraints, applied to whatever the provider currently rents. Policy
# lives in scripts/common.sh, not in a driver, because what makes a GPU suitable
# is a property of the MODEL — so these two move when MODEL_ID does.
#
#   48 = either FP8 Qwen3.6 checkpoint on one card — the 35B-A3B at ~35 GB or
#        the 27B at 30.9 GB. Both A/B against each other without a hardware
#        change; that is the point of them sharing this floor. Also the right
#        value for the 2 x 48 GB INT4 config below — this is per CARD, not in
#        total, so it does not change when GPU_COUNT does.
#   80 = the floor for BF16 GLM-4.7-Flash (62.4 GB). Raise GPU_MAX_PRICE with it
#        or the shortlist comes back empty rather than expensive.
GPU_MIN_VRAM_GB=48
GPU_MAX_PRICE=1.20

# Pinned so a rebuilt node fetches byte-identical weights.
#
# These four move TOGETHER, which is why they sit together. A parser that does
# not match the checkpoint returns prose where agents expect tool_calls, and it
# fails SILENTLY — aider will not surface it because it works via text diffs.
# verify.sh asserts the pairing against a case statement; extend that too when
# you add a checkpoint here.
#
# The publishing org must also be on the allowlist in gpu/provision.sh. That is
# deliberately a Git change, not a knob: it is the control that stops a typo'd
# MODEL_ID pulling arbitrary weights onto hardware we do not own.
MODEL_ID=Qwen/Qwen3.6-35B-A3B-FP8
MODEL_REVISION=95a723d08a9490559dae23d0cff1d9466213d989
TOOL_CALL_PARSER=qwen3_coder
REASONING_PARSER=qwen3

# --- Qwen3.6-27B, the same-card A/B ----------------------------------------
#
# Dense 27B, official Qwen FP8, ungated, safetensors only, 30.9 GB. Same
# publishing org and the same parsers as the primary, so this is the ONLY swap
# in this file that touches nothing else: no allowlist change in
# gpu/provision.sh, no GPU_MIN_VRAM_GB change, no TP change. Uncomment these
# four, comment the four above, ./scripts/gpu-up.sh.
#
# It is the stronger model on paper (SWE-bench 77.2 vs 73.4, Terminal-Bench 2.0
# 59.3 vs 51.5) and the weaker one to serve, on two counts that compound:
#
#   - dense reads all 27B params per token, the MoE reads ~3B — ~9x
#   - 16/64 full-attention layers vs ~10/40, so ~64 kB/token against ~20 kB.
#     ~12 GB of KV left after weights is ~190k tokens, i.e. ~3 concurrent 65k
#     streams against the MoE's ~6.
#
# Slower per stream AND fewer streams, for +3.8 SWE-bench. So switch on a
# task-class failure the reasoning budget cannot close, not on a benchmark
# delta — and measure it with bench/tasks/ rather than re-arguing it.
# Reasoning in docs/architecture.md; how the rejection rotted, in
# docs/design-notes.md §7.
#
# Also a vision-language checkpoint (Qwen3_5ForConditionalGeneration, with a
# vision_config) — every Qwen3.6 is. See the note in gpu/docker-compose.yml.
#
#MODEL_ID=Qwen/Qwen3.6-27B-FP8
#MODEL_REVISION=e89b16ebf1988b3d6befa7de50abc2d76f26eb09
#TOOL_CALL_PARSER=qwen3_coder
#REASONING_PARSER=qwen3

# --- GLM-4.7-Flash, the A/B candidate -------------------------------------
#
# Glm4MoeLiteForCausalLM, MoE 64 routed experts + 1 shared, 4 per token, MLA
# attention, text-only. Needs vLLM >= 0.26.0, which registers the architecture.
#
# BF16 31.2B params = 62.4 GB of weights, so it does NOT fit the 48 GB shortlist
# below — set GPU_MIN_VRAM_GB=80 and raise GPU_MAX_PRICE with it. The 96 GB RTX
# PRO 6000 Blackwell is the honest cell (~$2/hr): the 80 GB H100s cost 1.6x more
# and leave a third of the KV cache, because MLA here costs 54.1 kB/token —
# (512 + 64) x 2 B x 47 layers — i.e. 3.55 GB per 65k stream.
#
# Community FP8 (~32 GB) and AWQ 4-bit (~20 GB) checkpoints exist and would fit a
# 48 GB card, but each is published by an individual repackager rather than by
# zai-org, so using one means widening the provenance allowlist to someone who
# did not train the weights. That is a security decision, not a sizing one.
#
#MODEL_ID=zai-org/GLM-4.7-Flash
#MODEL_REVISION=7dd20894a642a0aa287e9827cb1a1f7f91386b67
#TOOL_CALL_PARSER=glm47
#REASONING_PARSER=glm47

# --- 2 × RTX 3090 (vast.ai, or owned) --------------------------------------
#
# Ampere has no FP8 tensor cores, so the checkpoint above will not serve well
# here — and probably will not load at all, since FP8 Marlin does not cover
# block-wise FP8 or MoE and Qwen3.6's FP8 is both. Serve INT4 instead; it is
# Ampere's native low precision. Same model, 21.5 GB, so MORE KV headroom than
# the FP8 path (~16 concurrent 65k streams vs ~6).
#
# Requires GPU_COUNT=2, TP=2, `ipc: host` uncommented, and widening the
# publishing-org gate in gpu/provision.sh — it refuses anything not from Qwen,
# and this is an Intel-published quant. Full runbook, including why vast.ai
# keeps billing after an automatic shutdown: docs/devops-setup.md §9.
#
#MODEL_ID=Intel/Qwen3.6-35B-A3B-int4-mixed-AutoRound
#MODEL_REVISION=65f69c73f17488236c85c85211f6ba28d7106157

# --- Qwen3.5-122B-A10B on 2 × 48 GB (A6000 or L40S) ------------------------
#
# The big-model config. 122B total / 10B activated, so decode still reads ~3x
# what the 35B primary reads — this buys capability, and costs tokens per second.
# Measure before adopting; it is an A/B candidate, not an upgrade.
#
# Sizes and revisions read from the Hugging Face API on 2026-08-12.
#
# WHICH CHECKPOINT — the choice is made by arithmetic, not preference. Two
# 48 GB cards is 96 GB, and 0.90 utilisation leaves 86.4 GB:
#
#   Qwen/Qwen3.5-122B-A10B          BF16  ~250 GB   no
#   Qwen/Qwen3.5-122B-A10B-FP8      ~127 GB (123.0B FP8 + 2.06B BF16)   no
#   Qwen/Qwen3.5-122B-A10B-GPTQ-Int4  65.05 GB, 39 shards               fits
#
# So INT4 is the only one of the three that runs here at all, which also settles
# the A6000-vs-L40S question: nothing about this config uses FP8, so Ampere's
# missing FP8 tensor cores cost nothing. INT4 is Ampere's native low precision.
#
# Unlike the 3090 config above, this is an OFFICIAL Qwen checkpoint, so
# gpu/provision.sh's publishing-org allowlist already passes it. No provenance
# widening, no third-party repackager. That is the main reason to prefer this
# route to a community quant of a smaller model.
#
# Qwen3_5MoeForConditionalGeneration — the same architecture the pinned engine
# image already serves for Qwen3.6, so vLLM support is not a new question.
#
#MODEL_ID=Qwen/Qwen3.5-122B-A10B-GPTQ-Int4
#MODEL_REVISION=30cd92cba9707a9aba09d1e490ed4b66b78e9606
#TOOL_CALL_PARSER=qwen3_coder
#REASONING_PARSER=qwen3
#
# GPTQ MoE needs the kernel named EXPLICITLY. Qwen puts --quantization moe_wna16
# in every launch command they publish for this checkpoint; without it vLLM picks
# gptq_marlin off config.json, which is the dense-GPTQ path. Read as an optional
# arg by gpu/provision.sh, and written out commented in gpu/docker-compose.yml —
# uncomment it there in the same change, exactly like `ipc: host`. verify.sh
# asserts both against MODEL_ID.
#VLLM_QUANTIZATION=moe_wna16
#
# Two cards, so: GPU_COUNT=2, TP=2, and `ipc: host` uncommented the same day.
#GPU_COUNT=2
#TP=2
#
# MAX_NUM_SEQS is not a spare knob here — it is the second-largest consumer of
# what is left after weights, and it competes with KV directly.
#
# 36 of the 48 layers are linear attention, each holding a constant-size
# recurrent state per decode sequence: 64 value heads x 128 head dim x 128 key
# head dim x 4 B (mamba_ssm_dtype is float32) = 4.19 MB per layer, ~151 MB per
# SEQUENCE. So the default 64 costs 9.7 GB of the 21.3 GB left over, and buys
# slots that KV cache cannot back:
#
#   86.4 GB usable - 65.05 GB weights = 21.3 GB
#     max_num_seqs=64  ->  9.7 GB state, ~11.6 GB KV  ->  ~7 streams @ 65k
#     max_num_seqs=16  ->  2.4 GB state, ~18.9 GB KV  -> ~12 streams @ 65k
#
# KV is 24 kB/token: 12 full-attention layers (1 in 4 of 48) x 2 KV heads x
# head_dim 256 x 2 B x 2. This is arithmetic — activations, NCCL buffers and
# vLLM's multimodal profiling reservation all land in the same 21.3 GB, so read
# the real cache size off the startup log on first boot before trusting it.
#MAX_NUM_SEQS=16
#
# 262,144 native. 65536 stays the served length; the arithmetic above is why.
#MAX_MODEL_LEN=65536
#
# RENTING THIS, rather than owning it: the shortlist filter is per CARD, both
# for VRAM and for price, so 48/1.20 still admits both candidates — but the bill
# is GPU_COUNT x that, ~$0.66/hr for 2 x A6000 against ~$1.58/hr for 2 x L40S.
#
# A6000 does NOT match GPU_FP8_FAMILIES and is excluded from the shortlist by
# design. Widening it is legitimate HERE and only here, because the FP8 the
# allowlist protects is not in play:
#GPU_FP8_FAMILIES="Ada|Blackwell|L40|H100|H200|H800|B200|B300|GB200|GB300|RTX 40|RTX 50|A6000|A40"
# ⚠️ Revert that line when MODEL_ID goes back to an FP8 checkpoint. Leaving it
# widened is precisely the silent failure the allowlist exists to prevent —
# renting Ampere and serving FP8 on it, slowly, with nothing to tell you.
# verify.sh fails the combination.
#
# 65.05 GB of weights: RUNPOD_DISK_GB=120 fits with the image, and a weights
# volume for this checkpoint alone wants ~100 GB.
#
# Full runbook: docs/devops-setup.md §10.

# Idle auto-shutdown. 45 min: a wrong shutdown costs a developer ~5 minutes of
# cold start; a wrong non-shutdown costs a full GPU-hour every hour. The
# asymmetry favours firing early. Clears a meeting or a lunch without covering
# an afternoon of inattention.
IDLE_MINUTES=45
