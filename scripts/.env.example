# Copy to .env, fill in, chmod 600. Gitignored.
#
# Deliberately separate from gateway/.env: a host can run the gateway without
# ever holding a credential that creates billable instances.

# ---------------------------------------------------------------- provider
#
# Which hardware the lifecycle scripts talk to. Everything above this line --
# gateway, tailnet policy, keys, spend, backups, draining -- is identical
# whichever you choose. See scripts/providers/README.md.
#
#   runpod   rented on-demand pods. Billed hourly, DESTROYED when idle.
#   ssh      a GPU box you own, or any VPS with a GPU + Docker + SSH.
#            Persistent: idle shutdown STOPS the engine, never the machine.
#   manual   you start the engine yourself; the scripts only observe.
#
# Adding a provider is one file in scripts/providers/ implementing six
# functions. Nothing else in the repo names a provider.
GPU_PROVIDER=runpod

# --- GPU_PROVIDER=ssh only -------------------------------------------------
# A tailnet name is ideal: then the box needs no public SSH at all.
#GPU_SSH_HOST=gpu-box
#GPU_SSH_USER=ubuntu
#GPU_SSH_KEY=~/.ssh/id_ed25519
#GPU_SSH_DIR=/opt/ai-infra

# --- every provider --------------------------------------------------------

# Ephemeral, tagged, pre-approved auth key minted in the Tailscale admin
# console for tag:gpu. Ephemeral so the node removes itself from the tailnet
# when it goes offline — right for instances destroyed nightly. Reusable, since
# gpu-up runs more than once. Max lifetime 90 days; rotate on that cadence.
# Revoking a key does NOT deauthorize already-connected nodes.
TS_AUTHKEY=tskey-auth-CHANGE-ME

# --- GPU_PROVIDER=runpod only ----------------------------------------------

# RunPod API key with pod create/terminate rights.
RUNPOD_API_KEY=CHANGE-ME

# Network volume. LEAVE EMPTY unless you have measured that you need one.
#
# It is not the obvious win it looks like. Measured on a live pod: 35 GB of
# weights fetched in 34 s, versus ~1 s from a warm volume. So it buys about half
# a minute of cold start, and costs:
#   - ~$0.07/GB/month, 24/7, whether or not a pod exists
#   - a hard pin to ONE datacenter, forever
#   - and only ~17 datacenters support volumes at all, which in practice can
#     exclude every region where the GPU you want currently has stock
#
# That last one is the killer: a volume can leave you unable to rent any
# suitable GPU. Empty means weights go on container disk, which is billed only
# while the pod runs and places no constraint on region.
#
# Sizing, if you do use one: ~35 GB for the primary FP8 checkpoint, ~54 GB more
# if you also keep the 27B A/B candidate. ~100 GB is honest; 200 GB was guessed.
RUNPOD_VOLUME_ID=

# Container disk when running WITHOUT a network volume. Must fit the image plus
# the checkpoint plus room to unpack it. Billed only while the pod exists.
RUNPOD_DISK_GB=120

# Ordered preference — dataCenterPriority=custom.
#
# Pick these on availability and jurisdiction, not latency: RTT lands only in
# time-to-first-token and token streaming hides it thereafter. The useful
# question is whether the GPU's region shares a failure mode (power grid,
# network, legal jurisdiction) with the office that depends on it. Somewhere
# decorrelated from your users beats somewhere close to them.
# A network volume is pinned to ONE datacenter, so a real fallback region needs
# its own volume; until then the second entry only helps if you accept a
# re-download.
RUNPOD_DATACENTERS=EU-SE-1,EU-NL-1,EU-RO-1

# Ada or newer, and 48 GB on ONE card. FP8 needs Ada: L40S and RTX 6000 Ada have
# native FP8 tensor cores; A6000/A40 are Ampere and do not, so serving the FP8
# checkpoint on them is a silent performance loss rather than an error.
#
# 48 GB on one card, not 48 GB in total: the checkpoint is ~35 GB, so a 24 GB
# card (RTX 4090) needs tensor parallelism, and consumer cards have no NVLink —
# TP then crosses PCIe and costs more than the cheaper hourly rate saves.
#
# Known-good ids (./scripts/gpu-up.sh --check-capacity prices whichever you set):
#   NVIDIA RTX 6000 Ada Generation   48 GB, usually the cheapest that qualifies
#   NVIDIA L40S                      48 GB, inference-tuned
# Quotes are required: common.sh sources this file with the shell, so an
# unquoted value containing a space parses as `VAR=NVIDIA` followed by the
# command `L40S` and every lifecycle script dies with "command not found".
RUNPOD_GPU_TYPE="NVIDIA L40S"

# --- every provider --------------------------------------------------------

# 1 steady-state. Set 2 only for the measurement week (27B A/B needs the second
# card, and so does the TP=1-vs-TP=2 comparison). Raising this to 2 also means
# uncommenting `ipc: host` in gpu/docker-compose.yml the same day.
GPU_COUNT=1
TP=1
MAX_MODEL_LEN=65536

# Pinned so a rebuilt node fetches byte-identical weights.
MODEL_ID=Qwen/Qwen3.6-35B-A3B-FP8
MODEL_REVISION=95a723d08a9490559dae23d0cff1d9466213d989

# Idle auto-shutdown. 45 min: a wrong shutdown costs a developer ~5 minutes of
# cold start; a wrong non-shutdown costs a full GPU-hour every hour. The
# asymmetry favours firing early. Clears a meeting or a lunch without covering
# an afternoon of inattention.
IDLE_MINUTES=45
