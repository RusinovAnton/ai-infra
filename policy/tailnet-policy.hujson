// Tailnet policy for the ai-infra deployment.
//
// Source of truth. Apply via the GitOps action in .github/workflows/, never by
// editing the admin console — a console edit leaves no trail in this repo and
// will be silently reverted by the next push.
//
// The whole policy lives in `grants`. There is deliberately NO `acls` block:
// a default allow-all `grants` entry silently overrides `acls` restrictions
// with no warning, and new tailnets ship exactly that.
{
	"tagOwners": {
		"tag:gateway": ["autogroup:admin"],
		"tag:gpu":     ["autogroup:admin"],

		// TRANSITIONAL — remove once no device advertises tag:testbed.
		// A tag must exist here before a device can advertise it, and a live
		// device should never hold a tag this file does not define. So the
		// retag is two saves: keep this line, move the device to tag:gateway,
		// then delete this line in a second push.
		"tag:testbed": ["autogroup:admin"],
	},

	// There is deliberately NO `groups` block, so this file contains no
	// personal identities and never needs to. Membership of the tailnet is
	// the developer roster: you only become a member by being invited, and
	// `autogroup:member` excludes tagged nodes, so the rented GPU box can
	// never match a developer rule.
	//
	// Reachability is not authorization. Reaching :443 gets you a 401 — the
	// LiteLLM virtual key is what grants use, and it is issued and revoked
	// per person on the gateway. Adding a login here would duplicate that
	// roster in a second place, in git, forever.
	//
	// If you ever need a member who is NOT a developer, that is the point to
	// introduce `group:devs` — and to accept teammates' logins living in this
	// repo's history.

	"grants": [
		// Members: the gateway's HTTPS port only. Never the GPU node.
		{ "src": ["autogroup:member"], "dst": ["tag:gateway"], "ip": ["tcp:443"] },

		// The gateway is the ONLY thing that may reach the engine.
		{ "src": ["tag:gateway"],  "dst": ["tag:gpu"],     "ip": ["tcp:8000"] },

		// Admin access, over the tailnet. Ports differ per node: the gateway
		// serves 443, the GPU node serves the engine. Do not grant ports that
		// nothing listens on — this policy's value is that it reads truthfully.
		{ "src": ["autogroup:admin"], "dst": ["tag:gateway"], "ip": ["tcp:22","tcp:443"] },
		{ "src": ["autogroup:admin"], "dst": ["tag:gpu"],     "ip": ["tcp:22","tcp:8000"] },

		// Each member reaches their own devices only — no cross-user access.
		{ "src": ["autogroup:member"], "dst": ["autogroup:self"], "ip": ["*"] },

		// NOTE: there is deliberately no grant with src tag:gpu. grants is
		// default-deny, so the rented node cannot initiate to anything on the
		// tailnet. That is load-bearing — the rented node is untrusted
		// hardware that now sits inside the perimeter. Absence is easy to
		// erase by accident, which is why the last test below asserts it.
	],

	"tests": [
		// There is no user-facing test here, and that is a real gap rather than an
		// oversight. A `tests` entry needs a concrete src — a login or a tag — so
		// any dev-facing assertion means committing somebody's identity to this
		// repo permanently. The two tag-based tests below carry the load-bearing
		// claims; verify the dev path interactively against a real non-admin
		// account instead (tailnet-admin.md#verifying-the-policy-honestly).
		//
		// Never use your own admin login for that check: it matches
		// autogroup:admin and passes for the wrong reason.

		// The gateway can reach the engine.
		{ "src": "tag:gateway",
		  "accept": ["tag:gpu:8000"],
		  "deny":   ["tag:gateway:22"] },

		// The rented node can reach NOTHING. This is the blast-radius assertion.
		{ "src": "tag:gpu",
		  "deny":   ["tag:gateway:443", "tag:gateway:22", "tag:gateway:4000"] },
	],
}
