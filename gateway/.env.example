# Copy to .env, fill in, chmod 600. .env is gitignored — keep it that way.
#
#   cp .env.example .env && chmod 600 .env
#   for v in LITELLM_MASTER_KEY LITELLM_DB_PASS ENGINE_SECRET UI_PASSWORD; do
#     printf '%s\n' "$v=$(openssl rand -hex 24)"
#   done
#
# LITELLM_MASTER_KEY must start with "sk-" — LiteLLM rejects keys that do not.

LITELLM_MASTER_KEY=sk-CHANGE-ME
LITELLM_DB_PASS=CHANGE-ME
UI_USERNAME=admin
UI_PASSWORD=CHANGE-ME

# The engine's --api-key. Defence in depth only; the tailnet ACL is the real
# control. scripts/gpu-up.sh rotates this on every launch and rewrites it here,
# so a copy sitting in RunPod instance metadata is a credential that expires
# with the pod rather than a long-lived one.
ENGINE_SECRET=CHANGE-ME

# Encrypts the Postgres dumps that scripts/pg-backup.sh writes. If unset, the
# dump is left in plaintext — a file containing every virtual key. Not a
# silent skip; the script warns.
BACKUP_PASSPHRASE=CHANGE-ME

# MagicDNS name of the GPU node. Must be the tailnet name, never localhost.
# Until the GPU node exists this points at a host that does not resolve, which
# is the correct Phase A state: error_hook.py turns that into a clear 503.
ENGINE_API_BASE=http://gpu.CHANGE-ME.ts.net:8000/v1
